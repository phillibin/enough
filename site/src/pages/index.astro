---
import Base from "../layouts/Base.astro";
import { getPolishedDrafts } from "../lib/drafts";

const sections = getPolishedDrafts();
---

<Base title="Moneysnake: A Speculative Biography">
  <article class="prose prose-stone prose-lg max-w-none
    prose-headings:font-serif
    prose-p:font-serif prose-p:leading-relaxed prose-p:text-[1.15rem]
    prose-li:font-serif
    prose-em:text-stone-700
    prose-hr:border-stone-300 prose-hr:my-12
    prose-blockquote:border-stone-300 prose-blockquote:font-serif">

    <h1 class="text-4xl font-serif font-medium tracking-tight mb-2">Moneysnake</h1>
    <p class="text-lg font-serif text-stone-500 mt-0 mb-16 italic">A Speculative Biography</p>

    {sections.map((section, i) => (
      <Fragment>
        <section id={section.slug} set:html={section.html} />
        {i < sections.length - 1 && <hr />}
      </Fragment>
    ))}
  </article>
</Base>
