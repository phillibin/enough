---
interface Props {
  title: string;
}

const { title } = Astro.props;
const isDev = import.meta.env.DEV;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body class="bg-stone-50 text-stone-900 min-h-screen">
    <header class="max-w-2xl mx-auto px-6 pt-12 pb-8 flex justify-end">
      {isDev && (
        <a
          href={`${base}/stats/index.html`}
          class="font-sans text-xs text-stone-400 hover:text-stone-700 border-b border-dotted border-stone-300"
        >
          stats →
        </a>
      )}
    </header>
    <main class="max-w-2xl mx-auto px-6 pb-24">
      <slot />
    </main>
  </body>
</html>
